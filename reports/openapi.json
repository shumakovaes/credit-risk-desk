  "components": {
    "schemas": {
      "ApplicationRequest": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "annual_rate_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Annual Rate Pct"
          },
          "months": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Months"
          },
          "account_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Account Id"
          },
          "as_of": {
            "type": "string",
            "format": "date",
            "title": "As Of"
          },
          "declared_monthly_income": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Declared Monthly Income"
          },
          "existing_monthly_payments": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Existing Monthly Payments"
          },
          "available_limit": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100000000.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Available Limit"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "annual_rate_pct",
          "months",
          "account_id",
          "as_of"
        ],
        "title": "ApplicationRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentRequest": {
        "properties": {
          "amount": {
            "type": "number",
            "maximum": 100000000.0,
            "exclusiveMinimum": 0.0,
            "title": "Amount"
          },
          "annual_rate_pct": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Annual Rate Pct"
          },
          "months": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Months"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "amount",
          "annual_rate_pct",
          "months"
        ],
        "title": "PaymentRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
